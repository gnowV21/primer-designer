# Normalise line endings: LF in the repository and in the working tree.
* text=auto eol=lf

# Windows scripts need CRLF to run under cmd.exe / PowerShell.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never convert, never diff as text.
*.sqlite   binary
*.sqlite3  binary
*.db       binary
*.parquet  binary
*.zip      binary
*.gz       binary
*.tar      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.xlsx     binary
*.docx     binary
*.pptx     binary
# BLAST+ database volumes (built locally by backend/scripts/build_blast_db.py)
*.nhr binary
*.nin binary
*.nsq binary
*.ndb binary
*.njs binary
*.nog binary
*.nos binary
*.not binary
*.ntf binary
*.nto binary
