# Phase 1 chatbot knowledge base — rebuilt from PubMed via POST /api/ingest.
# Generated data, not source: papers.db is user-specific and chroma/ holds ~440 MB
# of embeddings that are cheaper to regenerate than to version.
backend/data/papers.db
backend/data/chroma/
test-results/
.playwright-mcp/

# Screenshot artifacts
*.png
*.jpeg
*.jpg

# Local miRBase SQLite DB (built by scripts/build_db.py — not committed)
backend/db/mirbase.db

# BLAST databases — built by scripts/build_blast_db.py (large binary, not committed)
backend/data/blast_db/_tmp/
backend/data/blast_db/*.nhr
backend/data/blast_db/*.nin
backend/data/blast_db/*.nsq
backend/data/blast_db/*.ndb
backend/data/blast_db/*.njs
backend/data/blast_db/*.nog
backend/data/blast_db/*.nos
backend/data/blast_db/*.not
backend/data/blast_db/*.ntf
backend/data/blast_db/*.nto

# Ephemeral SQLite caches (regenerated at runtime, not committed)
backend/data/blast_cache.sqlite
backend/data/visualize_cache.sqlite
