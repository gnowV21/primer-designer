{
 "_about": "In silico report of published 3' isomiR cases (not a pass/fail validation); values from /api/design with backend defaults.",
 "published": {
  "hsa-miR-21-5p": {
   "source": "Magee 2017",
   "observation": "Stem-loop TaqMan cho dạng chuẩn bắt cả 0|+1, −1|0, −1|+1; trong tế bào chuyển nạp không phân biệt được các dạng.",
   "reference": "Ký hiệu 5′|3′ của bài gồm cả lệch đầu 5′; tool chỉ xét đầu 3′.",
   "comparison": "Khớp: bảng xếp ±1/+2 nt vào khoảng đo được 0–4 Ct, tức assay đo tổng các dạng. Đầu 22.1 vẫn là dạng nhiều nhất nên không có cảnh báo isoform trội."
  },
  "hsa-miR-33b-5p": {
   "source": "Schamberger 2014",
   "observation": "Assay \"GC\" và \"GCA\" bắt chéo nhau, trễ 2–4 Ct; giải trình tự thấy dạng dài hơn nhiều hơn tham chiếu.",
   "reference": "\"GC\" = đầu 3′ của 22.1 (20 nt); \"GCA\" = +1 nt so với 22.1.",
   "comparison": "Khớp về mức bắt: khoảng 0–4 Ct của ±1 nt chứa chính số đo 2–4 Ct của miRNA này. Khác về tỉ lệ: isomiRdb (pooled) cho dạng +1 ít hơn đầu 22.1, còn bài thấy dạng dài hơn nhiều hơn. Mẫu khác nhau, nên tool không bật cảnh báo isoform trội."
  },
  "hsa-miR-877-5p": {
   "source": "Schamberger 2014",
   "observation": "Assay GACA/GAC bắt nhau gần 0 Ct; GA trễ khoảng 3 Ct; assay GA bắt cả ba dạng.",
   "reference": "Bài dùng dạng GACA (24 nt) làm tham chiếu; 22.1 dài 20 nt (…CAGGG). So với 22.1: GA = +2, GAC = +3, GACA = +4 nt. Dạng 20 nt của 22.1 không được thử trong bài.",
   "comparison": "Khớp với cách ghi: bài chỉ so các dạng 22–24 nt với nhau, không có assay nhắm đầu 20 nt của 22.1, nên +3/+4 ghi \"not measured\" là đúng. isomiRdb cũng thấy dạng dài nhiều hơn đầu 22.1, nên cảnh báo isoform trội bật."
  },
  "hsa-miR-222-3p": {
   "source": "Nejad 2018; Pillman 2019",
   "observation": "TaqMan 21 nt bắt isoform 22–25 nt; isoform dài trội; không thấy mức giảm 70 % sau IFN.",
   "reference": "TaqMan 21 nt = độ dài 22.1; isoform 22–25 nt = +1 đến +4 nt so với 22.1.",
   "comparison": "Khớp: cảnh báo isoform trội và cờ fold-change đều bật. Tool ghi +3/+4 là \"not measured\", không nói assay bắt kém; Nejad thấy TaqMan vẫn bắt các dạng này nhưng không có số Ct theo từng dạng, nên tool không có số để dùng."
  },
  "hsa-miR-221-3p": {
   "source": "Pillman 2019",
   "observation": "Assay nhắm dạng dài hơn dạng trội 1 nt; báo \"giảm\" trong khi tổng tăng.",
   "reference": "Đại thực bào người/chuột, assay thương mại không công bố trình tự mồi.",
   "comparison": "Khớp: dạng trội là −1 nt, tức đầu 22.1 mà mồi RT nhắm dài hơn dạng trội 1 nt như bài mô tả; cảnh báo isoform trội bật."
  },
  "hsa-miR-27b-3p": {
   "source": "Pillman 2019",
   "observation": "Assay nhắm dạng dài hơn dạng trội 1 nt; báo \"giảm\" trong khi tổng tăng.",
   "reference": "Đại thực bào người/chuột, assay thương mại không công bố trình tự mồi.",
   "comparison": "Khớp nhưng sát ngưỡng: dạng −1 nt gần bằng đầu 22.1; cảnh báo chỉ bật nhờ mốc 0,8 (luật R1 \"> 1\" sẽ bỏ sót ca này)."
  },
